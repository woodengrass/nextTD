simplified_ui true
mouse_mode true
pane_frames false
session_serialization false
show_startup_tips false
show_release_notes false
theme "tdnext-dividers"
theme_dark "tdnext-dividers"
theme_light "tdnext-dividers"
themes {
    tdnext-dividers {
        frame_unselected {
            base 128 128 128
            emphasis_0 128 128 128
            emphasis_1 128 128 128
            emphasis_2 128 128 128
            emphasis_3 128 128 128
        }
        frame_selected {
            base 128 128 128
            background 238
            emphasis_0 166
            emphasis_1 51
            emphasis_2 201
            emphasis_3 215
        }
        frame_highlight {
            base 128 128 128
            background 154
            emphasis_0 128 128 128
            emphasis_1 128 128 128
            emphasis_2 154
            emphasis_3 154
        }
    }
}
