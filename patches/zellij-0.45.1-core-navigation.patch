+#[test]
+fn navigation_pending_layout_defers_open_and_return_until_layout_applied() {
+    use crate::route::NotificationEnd;
+    let mut mock = MockScreen::new(Size {
+        cols: 121,
+        rows: 20,
+    });
+    let screen_thread = mock.run(Some(TiledPaneLayout::default()), vec![]);
+    let server_events = Arc::new(Mutex::new(vec![]));
+    let server_receiver = mock.server_receiver.take().unwrap();
+    let server_thread = log_actions_in_thread!(
+        server_events,
+        ServerInstruction::KillSession,
+        server_receiver
+    );
+    let layout = TiledPaneLayout::default();
+    mock.to_screen
+        .send(ScreenInstruction::NewTab(
+            None,
+            None,
+            Some(layout.clone()),
+            vec![],
+            Some("tools".into()),
+            (Some(vec![]), Some(vec![])),
+            None,
+            false,
+            false,
+            (1, false),
+            None,
+        ))
+        .unwrap();
+    let (open_tx, mut open_rx) = tokio::sync::oneshot::channel();
+    let (return_tx, mut return_rx) = tokio::sync::oneshot::channel();
+    let (barrier_tx, barrier_rx) = tokio::sync::oneshot::channel();
+    mock.to_screen
+        .send(ScreenInstruction::OpenTabWithReturn(
+            "tools".into(),
+            false,
+            None,
+            1,
+            Some(NotificationEnd::new(open_tx)),
+        ))
+        .unwrap();
+    mock.to_screen
+        .send(ScreenInstruction::ReturnToOrigin(
+            1,
+            Some(NotificationEnd::new(return_tx)),
+        ))
+        .unwrap();
+    mock.to_screen
+        .send(ScreenInstruction::RenameTabWithId(
+            0,
+            b"origin".to_vec(),
+            Some(NotificationEnd::new(barrier_tx)),
+        ))
+        .unwrap();
+    barrier_rx.blocking_recv().unwrap();
+    let open_pending = matches!(
+        open_rx.try_recv(),
+        Err(tokio::sync::oneshot::error::TryRecvError::Empty)
+    );
+    let return_pending = matches!(
+        return_rx.try_recv(),
+        Err(tokio::sync::oneshot::error::TryRecvError::Empty)
+    );
+    mock.to_screen
+        .send(ScreenInstruction::ApplyLayout(
+            layout,
+            vec![],
+            vec![(5, None)],
+            vec![],
+            HashMap::new(),
+            1,
+            false,
+            (1, false),
+            None,
+            None,
+        ))
+        .unwrap();
+    let (done_tx, done_rx) = std::sync::mpsc::channel();
+    std::thread::spawn(move || {
+        let result = (open_rx.blocking_recv(), return_rx.blocking_recv());
+        done_tx.send(result).unwrap();
+    });
+    let completed = done_rx.recv_timeout(std::time::Duration::from_secs(5));
+    let (query_tx, query_rx) = crossbeam::channel::bounded(1);
+    mock.to_screen
+        .send(ScreenInstruction::GetCurrentTabInfo {
+            client_id: 1,
+            response_channel: query_tx,
+        })
+        .unwrap();
+    let current_tab = query_rx.recv_timeout(std::time::Duration::from_secs(5));
+    mock.teardown(vec![server_thread, screen_thread]);
+    assert!(open_pending && return_pending);
+    let (open, returned) = completed.unwrap();
+    assert!(open.is_ok() && returned.is_ok());
+    assert_eq!(current_tab.unwrap().unwrap().name, "origin");
+}
