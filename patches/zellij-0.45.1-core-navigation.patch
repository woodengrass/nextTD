+fn navigation_screen(mirrored: bool) -> Screen {
+    let size = Size {
+        cols: 121,
+        rows: 20,
+    };
+    let (mut screen, _, _) = create_new_screen_with_capture(size, true, true, true, mirrored);
+    new_tab(&mut screen, 1, 0);
+    new_tab(&mut screen, 2, 1);
+    screen.tabs.get_mut(&0).unwrap().name = "origin".into();
+    screen.tabs.get_mut(&1).unwrap().name = "tools".into();
+    screen.go_to_tab(1, 1).unwrap();
+    screen
+}
+
+#[test]
+fn navigation_returns_to_original_tab_and_pane() {
+    let mut screen = navigation_screen(false);
+    let origin = screen.get_active_pane_id(&1);
+    screen.open_tab_with_return("tools", 1).unwrap();
+    screen.return_to_origin(1).unwrap();
+    assert_eq!(
+        (
+            screen.get_active_tab(1).unwrap().id,
+            screen.get_active_pane_id(&1)
+        ),
+        (0, origin)
+    );
+}
+
+#[test]
+fn navigation_reconnect_restores_original_tab_and_pane() {
+    for client_id in [1, 2] {
+        let mut screen = navigation_screen(false);
+        let origin = screen.get_active_pane_id(&1);
+        screen.open_tab_with_return("tools", 1).unwrap();
+        screen.remove_client(1).unwrap();
+        screen.add_client(client_id, false).unwrap();
+        screen.return_to_origin(client_id).unwrap();
+        assert_eq!(
+            (screen.get_active_tab(client_id).unwrap().id, screen.get_active_pane_id(&client_id)),
+            (0, origin),
+            "reconnected client {client_id}"
+        );
+    }
+}
+
+#[test]
+fn navigation_reconnect_survives_unknown_and_duplicate_removals() {
+    let mut screen = navigation_screen(false);
+    let origin = screen.get_active_pane_id(&1);
+    screen.open_tab_with_return("tools", 1).unwrap();
+    screen.remove_client(1).unwrap();
+    screen.remove_client(999).unwrap();
+    screen.remove_client(1).unwrap();
+    screen.add_client(2, false).unwrap();
+    screen.return_to_origin(2).unwrap();
+    assert_eq!((screen.get_active_tab(2).unwrap().id, screen.get_active_pane_id(&2)), (0, origin));
+}
+
+#[test]
+fn navigation_reconnect_does_not_transfer_nonfinal_client_origin() {
+    let mut screen = navigation_screen(false);
+    screen.add_client(2, false).unwrap();
+    screen.open_tab_with_return("tools", 1).unwrap();
+    screen.remove_client(1).unwrap();
+    screen.remove_client(2).unwrap();
+    screen.add_client(3, false).unwrap();
+    screen.go_to_tab(2, 3).unwrap();
+    screen.return_to_origin(3).unwrap();
+    assert_eq!(screen.get_active_tab(3).unwrap().id, 1);
+}
+
+#[test]
+fn navigation_reconnect_preserves_origin_while_away_from_destination() {
+    let mut screen = navigation_screen(false);
+    new_tab(&mut screen, 3, 2);
+    screen.go_to_tab(1, 1).unwrap();
+    screen.open_tab_with_return("tools", 1).unwrap();
+    screen.remove_client(1).unwrap();
+    screen.add_client(2, true).unwrap();
+    screen.return_to_origin(2).unwrap();
+    screen.go_to_tab(2, 2).unwrap();
+    screen.return_to_origin(2).unwrap();
+    assert_eq!(screen.get_active_tab(2).unwrap().id, 0);
+}
+
+#[test]
+fn navigation_reconnect_closed_origin_before_reuse_is_not_restored() {
+    let mut screen = navigation_screen(false);
+    screen.open_tab_with_return("tools", 1).unwrap();
+    screen.remove_client(1).unwrap();
+    screen.close_tab_by_id(0).unwrap();
+    screen.add_client(2, false).unwrap();
+    new_tab(&mut screen, 99, 0);
+    let position = screen.tabs.get(&1).unwrap().position;
+    screen.go_to_tab(position + 1, 2).unwrap();
+    screen.return_to_origin(2).unwrap();
+    assert_eq!(screen.get_active_tab(2).unwrap().id, 1);
+}
+
+#[test]
+fn navigation_reconnect_repeated_cycles_restore_once() {
+    let mut screen = navigation_screen(false);
+    for (old, new) in [(1, 2), (2, 1)] {
+        let origin = screen.get_active_pane_id(&old);
+        screen.open_tab_with_return("tools", old).unwrap();
+        screen.remove_client(old).unwrap();
+        screen.add_client(new, false).unwrap();
+        screen.return_to_origin(new).unwrap();
+        assert_eq!((screen.get_active_tab(new).unwrap().id, screen.get_active_pane_id(&new)), (0, origin));
+        screen.go_to_tab(2, new).unwrap();
+        screen.return_to_origin(new).unwrap();
+        assert_eq!(screen.get_active_tab(new).unwrap().id, 1);
+        screen.go_to_tab(1, new).unwrap();
+    }
+}
