diff --git a/zellij-server/src/desktop_chrome.rs b/zellij-server/src/desktop_chrome.rs
new file mode 100644
index 0000000..bfa458d
--- /dev/null
+++ b/zellij-server/src/desktop_chrome.rs
@@ -0,0 +1,160 @@
+use serde::Deserialize;
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::OnceLock;
+use unicode_width::{UnicodeWidthChar, UnicodeWidthStr};
+use zellij_utils::pane_size::{Size, Viewport};
+
+static CHROME: OnceLock<Option<DesktopChrome>> = OnceLock::new();
+static COLLAPSED: AtomicBool = AtomicBool::new(false);
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub(crate) enum Placement {
+    Sidebar,
+    Header,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+pub(crate) struct ChromeItem {
+    pub id: String,
+    pub name: String,
+    pub icon: String,
+    pub shortcuts: String,
+    pub placement: Placement,
+    pub tab_name: String,
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct DesktopChrome {
+    pub items: Vec<ChromeItem>,
+}
+
+impl DesktopChrome {
+    pub fn load(path: &Path) -> anyhow::Result<Self> {
+        let file = std::fs::File::open(path)?;
+        let items = serde_json::from_reader(file)?;
+        Ok(Self { items })
+    }
+}
+
+pub(crate) fn current() -> Option<&'static DesktopChrome> {
+    CHROME.get_or_init(|| {
+        std::env::var_os("TDNEXT_CHROME_FILE").and_then(|path| {
+            match DesktopChrome::load(Path::new(&path)) {
+                Ok(chrome) => Some(chrome),
+                Err(error) => {
+                    log::error!("Failed to load desktop chrome: {error:#}");
+                    None
+                },
+            }
+        })
+    }).as_ref()
+}
+
+pub(crate) fn content_viewport(size: Size) -> Viewport {
+    if current().is_none() {
+        return size.into();
+    }
+    let width = if COLLAPSED.load(Ordering::Relaxed) { 10 } else { 22 };
+    let x = width.min(size.cols.saturating_sub(1));
+    let y = usize::from(size.rows >= 3);
+    let bottom = if size.rows >= 5 { 3 } else if size.rows >= 4 { 2 } else { usize::from(size.rows >= 3) };
+    Viewport { x, y, cols: size.cols - x, rows: size.rows - y - bottom }
+}
+
+pub(crate) fn toggle() {
+    COLLAPSED.fetch_xor(true, Ordering::Relaxed);
+}
+
+fn clip(text: &str, width: usize) -> String {
+    let mut used = 0;
+    text.chars().filter(|c| !c.is_control()).take_while(|c| {
+        used += c.width().unwrap_or(0);
+        used <= width
+    }).collect()
+}
+
+fn padded(text: &str, width: usize) -> String {
+    let text = clip(text, width);
+    let padding = width.saturating_sub(UnicodeWidthStr::width(text.as_str()));
+    format!("{text}{}", " ".repeat(padding))
+}
+
+pub(crate) enum Click<'a> {
+    Toggle,
+    Sidebar(&'a str),
+    Header(&'a str),
+    Chrome,
+    Content,
+}
+
+impl DesktopChrome {
+    pub fn render(&self, size: Size, active_tab: &str) -> String {
+        let viewport = content_viewport(size);
+        if size.rows == 0 || size.cols == 0 { return String::new(); }
+        let mut output = String::from("\x1b7\x1b[0m");
+        if viewport.y > 0 {
+            let header = self.items.iter().filter(|item| matches!(item.placement, Placement::Header))
+                .map(|item| format!(" {} {} ", item.icon, item.name)).collect::<String>();
+            let start = size.cols.saturating_sub(UnicodeWidthStr::width(header.as_str()));
+            let title = padded(" TDNEXT", start);
+            output.push_str(&format!("\x1b[1;1H\x1b[48;5;237m\x1b[38;5;255m{}\x1b[0m", padded(&format!("{title}{header}"), size.cols)));
+        }
+        for row in viewport.y..viewport.y + viewport.rows {
+            if viewport.x == 0 { break; }
+            let item = self.items.iter().filter(|item| matches!(item.placement, Placement::Sidebar)).nth(row.saturating_sub(viewport.y + 1));
+            let text = if row == viewport.y {
+                if COLLAPSED.load(Ordering::Relaxed) { " > F7 ".to_owned() } else { " < F7 Desktop".to_owned() }
+            } else if let Some(item) = item {
+                let selected = if item.tab_name == active_tab { ">" } else { " " };
+                let name = if item.name.is_empty() { &item.id } else { &item.name };
+                if COLLAPSED.load(Ordering::Relaxed) { format!("{selected} {}", item.icon) } else { format!("{selected} {} {name}", item.icon) }
+            } else { String::new() };
+            output.push_str(&format!("\x1b[{};1H\x1b[48;5;236m\x1b[38;5;255m{}\x1b[38;5;245m│\x1b[0m", row + 1, padded(&text, viewport.x - 1)));
+        }
+        let bottom = size.rows.saturating_sub(viewport.y + viewport.rows);
+        if bottom > 0 {
+            let separator = usize::from(bottom > 2);
+            if separator > 0 {
+                output.push_str(&format!("\x1b[{};1H\x1b[48;5;237m\x1b[38;5;245m{}\x1b[0m", viewport.y + viewport.rows + 1, "─".repeat(size.cols)));
+            }
+            let tool = self.items.iter().find(|item| item.tab_name == active_tab)
+                .map(|item| format!("Tool ({}): {}", item.name, item.shortcuts))
+                .unwrap_or_else(|| "No views enabled".to_owned());
+            output.push_str(&format!("\x1b[{};1H\x1b[48;5;237m\x1b[38;5;255m{}\x1b[0m", viewport.y + viewport.rows + separator + 1, padded(&tool, size.cols)));
+            if bottom > 1 {
+                let mut hints = String::from("Global: Ctrl+q quit Ctrl+p panes");
+                if self.items.iter().any(|item| matches!(item.placement, Placement::Header)) { hints.push_str(" Alt+o header"); }
+                let count = self.items.iter().filter(|item| matches!(item.placement, Placement::Sidebar)).count().min(9);
+                if count == 1 { hints.push_str(" Alt+1 view"); }
+                else if count > 1 { hints.push_str(&format!(" Alt+1..{count} views")); }
+                output.push_str(&format!("\x1b[{};1H\x1b[48;5;237m\x1b[38;5;255m{}\x1b[0m", size.rows, padded(&hints, size.cols)));
+            }
+        }
+        output.push_str("\x1b8");
+        output
+    }
+
+    pub fn click(&self, size: Size, row: usize, col: usize) -> Click<'_> {
+        let viewport = content_viewport(size);
+        if viewport.y > 0 && row == 0 {
+            let header_width: usize = self.items.iter().filter(|item| matches!(item.placement, Placement::Header))
+                .map(|item| UnicodeWidthStr::width(format!(" {} {} ", item.icon, item.name).as_str())).sum();
+            let mut start = size.cols.saturating_sub(header_width);
+            for item in self.items.iter().filter(|item| matches!(item.placement, Placement::Header)) {
+                let label = format!(" {} {} ", item.icon, item.name);
+                let end = start + UnicodeWidthStr::width(clip(&label, size.cols).as_str());
+                if col >= start && col < end { return Click::Header(&item.tab_name); }
+                start = end;
+            }
+            return Click::Chrome;
+        }
+        if col < viewport.x && row >= viewport.y && row < viewport.y + viewport.rows {
+            if row == viewport.y { return Click::Toggle; }
+            return self.items.iter().filter(|item| matches!(item.placement, Placement::Sidebar))
+                .nth(row - viewport.y - 1).map(|item| Click::Sidebar(item.tab_name.as_str())).unwrap_or(Click::Chrome);
+        }
+        if row >= viewport.y + viewport.rows { Click::Chrome } else { Click::Content }
+    }
+}
