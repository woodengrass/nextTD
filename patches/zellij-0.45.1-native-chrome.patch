diff --git a/zellij-server/src/desktop_chrome.rs b/zellij-server/src/desktop_chrome.rs
new file mode 100644
index 0000000..bfa458d
--- /dev/null
+++ b/zellij-server/src/desktop_chrome.rs
@@ -0,0 +1,229 @@
+use serde::Deserialize;
+use std::collections::HashSet;
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::OnceLock;
+use unicode_width::{UnicodeWidthChar, UnicodeWidthStr};
+use zellij_utils::pane_size::{Size, Viewport};
+
+static CHROME: OnceLock<Option<DesktopChrome>> = OnceLock::new();
+static COLLAPSED: AtomicBool = AtomicBool::new(false);
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub(crate) enum Placement {
+    Sidebar,
+    Header,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+pub(crate) struct ChromeItem {
+    pub id: String,
+    pub name: String,
+    pub icon: String,
+    pub shortcuts: String,
+    pub placement: Placement,
+    pub tab_name: String,
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct DesktopChrome {
+    pub items: Vec<ChromeItem>,
+}
+
+impl DesktopChrome {
+    pub fn load(path: &Path) -> anyhow::Result<Self> {
+        let file = std::fs::File::open(path)?;
+        let items = serde_json::from_reader(file)?;
+        Ok(Self { items })
+    }
+}
+
+pub(crate) fn current() -> Option<&'static DesktopChrome> {
+    CHROME.get_or_init(|| {
+        std::env::var_os("TDNEXT_CHROME_FILE").and_then(|path| {
+            match DesktopChrome::load(Path::new(&path)) {
+                Ok(chrome) => Some(chrome),
+                Err(error) => {
+                    log::error!("Failed to load desktop chrome: {error:#}");
+                    None
+                },
+            }
+        })
+    }).as_ref()
+}
+
+pub(crate) fn content_viewport(size: Size) -> Viewport {
+    if current().is_none() {
+        return size.into();
+    }
+    let width = if COLLAPSED.load(Ordering::Relaxed) { 10 } else { 22 };
+    let x = width.min(size.cols.saturating_sub(1));
+    let y = if size.rows >= 6 { 2 } else { usize::from(size.rows >= 3) };
+    let bottom = if size.rows >= 5 { 3 } else if size.rows >= 4 { 2 } else { usize::from(size.rows >= 3) };
+    Viewport { x, y, cols: size.cols - x, rows: size.rows - y - bottom }
+}
+
+pub(crate) fn toggle() {
+    COLLAPSED.fetch_xor(true, Ordering::Relaxed);
+}
+
+fn clip(text: &str, width: usize) -> String {
+    let mut used = 0;
+    text.chars().filter(|c| !c.is_control()).take_while(|c| {
+        used += c.width().unwrap_or(0);
+        used <= width
+    }).collect()
+}
+
+pub(crate) enum Click<'a> {
+    Toggle,
+    Sidebar(&'a str),
+    Header(&'a str),
+    Chrome,
+    Content,
+}
+
+struct RailGeometry {
+    tiles: std::ops::Range<usize>,
+    hints: Option<usize>,
+}
+
+impl RailGeometry {
+    fn new(size: Size, viewport: Viewport, count: usize, collapsed: bool) -> Self {
+        let start = viewport.y.saturating_add(6);
+        let end = start.saturating_add(count.saturating_mul(3)).min(viewport.y + viewport.rows);
+        let end = if end > start && (end - start) % 3 == 1 { end - 1 } else { end };
+        let tiles = start..end.max(start);
+        let hint_row = size.rows.saturating_sub(4);
+        let hints = (!collapsed && hint_row >= tiles.end && hint_row >= viewport.y + 5).then_some(hint_row);
+        Self { tiles, hints }
+    }
+
+    fn tile_index(&self, row: usize) -> Option<usize> {
+        self.tiles.contains(&row).then(|| (row - self.tiles.start) / 3)
+    }
+}
+
+impl DesktopChrome {
+    pub fn render(&self, size: Size, active_tab: &str, sidebar_tab: &str, live_tabs: &HashSet<&str>) -> Vec<String> {
+        let viewport = content_viewport(size);
+        if size.rows == 0 || size.cols == 0 { return Vec::new(); }
+        let (surface, raised, selected_bg, selected_fg, separator_color, foreground, muted) =
+            ("\x1b[40m", "\x1b[40m", "\x1b[46m", "\x1b[97m", "\x1b[38;2;128;128;128m", "\x1b[97m", "\x1b[37m");
+        let mut output = Vec::new();
+        if viewport.y > 0 {
+            let headers: Vec<_> = self.items.iter().filter(|item| matches!(item.placement, Placement::Header))
+                .enumerate().map(|(index, item)| format!(" {}{} ", item.name, if index == 0 { " [Alt+o]" } else { "" })).collect();
+            let width: usize = headers.iter().map(|label| UnicodeWidthStr::width(label.as_str()) + 2).sum();
+            let start = size.cols.saturating_sub(width);
+            let title = clip("TERMINAL DESKTOP", start.saturating_sub(1));
+            let title_padding = start.saturating_sub(1 + UnicodeWidthStr::width(title.as_str()));
+            let mut header = format!("\x1b[1;1H{surface}{}{foreground}\x1b[1m{title}\x1b[0m{surface}{}", if start > 0 { " " } else { "" }, " ".repeat(title_padding));
+            let mut remaining = size.cols - start;
+            for label in headers {
+                if remaining == 0 { break; }
+                let label = clip(&label, remaining - 1);
+                let label_width = UnicodeWidthStr::width(label.as_str());
+                remaining -= 1 + label_width;
+                header.push_str(&format!("{raised} {foreground}\x1b[1;7m{label}\x1b[0m{raised}"));
+                if remaining > 0 { header.push(' '); remaining -= 1; }
+            }
+            output.push(header);
+        }
+        if viewport.y > 1 {
+            let left = viewport.x.saturating_sub(1);
+            let junction = if viewport.x > 0 { "┬" } else { "" };
+            output.push(format!("\x1b[2;1H\x1b[49m{separator_color}{}{junction}{}\x1b[0m", "─".repeat(left), "─".repeat(size.cols.saturating_sub(viewport.x))));
+        }
+        let collapsed = COLLAPSED.load(Ordering::Relaxed);
+        let rail = RailGeometry::new(size, viewport, self.items.iter().filter(|item| matches!(item.placement, Placement::Sidebar)).count(), collapsed);
+        for row in viewport.y..size.rows {
+            if viewport.x == 0 { break; }
+            let offset = row - viewport.y;
+            let item = rail.tile_index(row).and_then(|index| self.items.iter().filter(|item| matches!(item.placement, Placement::Sidebar)).nth(index));
+            let available = item.is_some_and(|item| live_tabs.contains(item.tab_name.as_str()));
+            let selected = available && item.is_some_and(|item| item.tab_name == sidebar_tab);
+            let text = if offset == 1 {
+                if collapsed { " Expand".to_owned() } else { " F7: Collapse".to_owned() }
+            } else if offset == 2 && !collapsed { " WORKSPACE".to_owned() }
+            else if offset == 4 && !collapsed { " VIEWS".to_owned() }
+            else if rail.hints == Some(row) { " Alt+1..9 switch".to_owned() }
+            else if rail.hints.is_some_and(|first| row == first + 1) { " Ctrl+q quit".to_owned() }
+            else if offset >= 6 && (offset - 6) % 3 == 1 {
+                item.map(|item| {
+                    let marker = if selected && item.tab_name == active_tab { ">" } else { " " };
+                    let name = if item.name.is_empty() { &item.id } else { &item.name };
+                    if collapsed { format!("{marker} {}", item.icon) } else { format!("{marker} {}{} {name}", item.icon, " ".repeat(4usize.saturating_sub(UnicodeWidthStr::width(item.icon.as_str())))) }
+                }).unwrap_or_default()
+            } else { String::new() };
+            let tile = selected && offset >= 6 && row < viewport.y + viewport.rows;
+            let background = if tile { selected_bg } else if offset >= 6 && rail.hints.is_none_or(|first| row < first) { raised } else { surface };
+            if viewport.x == 1 {
+                output.push(format!("\x1b[{};1H\x1b[49m{separator_color}│\x1b[0m", row + 1));
+            } else {
+                let color = if tile && !text.is_empty() { selected_fg } else if (item.is_some() && !available) || offset == 4 && !collapsed || offset == 5 && !collapsed || rail.hints.is_some_and(|first| row >= first && row <= first + 2) { muted } else { foreground };
+                let label = if item.is_some() { text.as_str() } else { text.strip_prefix(' ').unwrap_or(&text) };
+                let width = viewport.x.saturating_sub(3);
+                let weight = if (!label.is_empty() && tile) || (offset == 2 || offset == 3) && !collapsed { "\x1b[1m" } else { "" };
+                let label = clip(label, width);
+                let padding = width.saturating_sub(UnicodeWidthStr::width(label.as_str()));
+                let blank_style = !collapsed && (offset == 3 || offset == 5 || rail.hints.is_some_and(|first| row == first + 2));
+                output.push(format!("\x1b[{};1H{surface} {background}{color}{weight}{label}{}{background}{}\x1b[0m{surface} \x1b[49m{separator_color}│\x1b[0m", row + 1, if blank_style { "" } else { "\x1b[0m" }, " ".repeat(padding)));
+            }
+        }
+        let bottom = size.rows.saturating_sub(viewport.y + viewport.rows);
+        if bottom > 0 {
+            let separator = usize::from(bottom > 2);
+            if separator > 0 {
+                output.push(format!("\x1b[{};{}H\x1b[49m{separator_color}├{}\x1b[0m", viewport.y + viewport.rows + 1, viewport.x.max(1), "─".repeat(viewport.cols)));
+            }
+            let tool = self.items.iter().find(|item| item.tab_name == active_tab)
+                .map(|item| format!("Tool ({}): {}", item.name, item.shortcuts))
+                .unwrap_or_else(|| "No views enabled".to_owned());
+            let tool_width = viewport.cols.saturating_sub(2);
+            let tool_text = if UnicodeWidthStr::width(tool.as_str()) > tool_width { format!("{}…", clip(&tool, tool_width.saturating_sub(1))) } else { tool };
+            output.push(format!("\x1b[{};{}H{surface} {foreground}{tool_text}\x1b[39m{} \x1b[0m", viewport.y + viewport.rows + separator + 1, viewport.x + 1, " ".repeat(tool_width.saturating_sub(UnicodeWidthStr::width(tool_text.as_str())))));
+            if bottom > 1 {
+                let mut hints = String::from("Global: Ctrl+q quit Ctrl+p panes");
+                if self.items.iter().any(|item| matches!(item.placement, Placement::Header)) { hints.push_str(" Alt+o header"); }
+                let count = self.items.iter().filter(|item| matches!(item.placement, Placement::Sidebar)).count().min(9);
+                if count == 1 { hints.push_str(" Alt+1 view"); }
+                else if count > 1 { hints.push_str(&format!(" Alt+1..{count} views")); }
+                let hint_width = viewport.cols.saturating_sub(2);
+                let hint_text = if UnicodeWidthStr::width(hints.as_str()) > hint_width { format!("{}…", clip(&hints, hint_width.saturating_sub(1))) } else { hints };
+                output.push(format!("\x1b[{};{}H{surface} {foreground}{hint_text}\x1b[39m{} \x1b[0m", size.rows, viewport.x + 1, " ".repeat(hint_width.saturating_sub(UnicodeWidthStr::width(hint_text.as_str())))));
+            }
+        }
+        output
+    }
+
+    pub fn click(&self, size: Size, row: usize, col: usize, live_tabs: &HashSet<&str>) -> Click<'_> {
+        let viewport = content_viewport(size);
+        if viewport.y > 0 && row == 0 {
+            let header_width: usize = self.items.iter().filter(|item| matches!(item.placement, Placement::Header))
+                .enumerate().map(|(index, item)| UnicodeWidthStr::width(format!(" {}{} ", item.name, if index == 0 { " [Alt+o]" } else { "" }).as_str()) + 2).sum();
+            let mut start = size.cols.saturating_sub(header_width);
+            for (index, item) in self.items.iter().filter(|item| matches!(item.placement, Placement::Header)).enumerate() {
+                let label = format!(" {}{} ", item.name, if index == 0 { " [Alt+o]" } else { "" });
+                let end = start.saturating_add(UnicodeWidthStr::width(label.as_str()) + 2).min(size.cols);
+                if col >= start && col < end { return Click::Header(&item.tab_name); }
+                start = end;
+            }
+            return Click::Chrome;
+        }
+        if col < viewport.x && row >= viewport.y {
+            let offset = row - viewport.y;
+            if col == viewport.x - 1 { return Click::Chrome; }
+            if offset == 1 { return Click::Toggle; }
+            let rail = RailGeometry::new(size, viewport, self.items.iter().filter(|item| matches!(item.placement, Placement::Sidebar)).count(), COLLAPSED.load(Ordering::Relaxed));
+            if let Some(index) = rail.tile_index(row) {
+                return self.items.iter().filter(|item| matches!(item.placement, Placement::Sidebar))
+                    .nth(index).filter(|item| live_tabs.contains(item.tab_name.as_str()))
+                    .map(|item| Click::Sidebar(item.tab_name.as_str())).unwrap_or(Click::Chrome);
+            }
+            return Click::Chrome;
+        }
+        if row < viewport.y || row >= viewport.y + viewport.rows { Click::Chrome } else { Click::Content }
+    }
+}
