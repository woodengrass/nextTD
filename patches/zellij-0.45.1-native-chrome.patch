+    pub fn adjust_desktop_chrome(&mut self) -> Result<()> {
+        if crate::desktop_chrome::current().is_none() { return Ok(()); }
+        let old = *self.viewport.borrow();
+        let new = crate::desktop_chrome::content_viewport(self.size);
+        if old.x == new.x || new.cols == 0 { return Ok(()); }
+        let expanding = new.x > old.x;
+        let delta = old.x.abs_diff(new.x);
+        for pane in self.tiled_panes.panes.values_mut() {
+            let mut geom = pane.position_and_size();
+            if geom.x == old.x {
+                let cols = if expanding { geom.cols.as_usize().saturating_sub(delta) } else { geom.cols.as_usize() + delta };
+                geom.cols.set_inner(cols);
+                if geom.cols.is_percent() {
+                    let cols = f64::from(u32::try_from(cols)?);
+                    let total = f64::from(u32::try_from(new.cols)?);
+                    geom.cols.set_percent(cols * 100.0 / total);
+                }
+                geom.x = new.x;
+            } else {
+                geom.x = if expanding { geom.x + delta } else { geom.x.saturating_sub(delta) };
+                if geom.cols.is_percent() {
+                    let cols = f64::from(u32::try_from(geom.cols.as_usize())?);
+                    let total = f64::from(u32::try_from(new.cols)?);
+                    geom.cols.set_percent(cols * 100.0 / total);
+                }
+            }
+            if pane.geom_override().is_some() { pane.set_geom_override(geom); } else { pane.set_geom(geom); }
+        }
+        *self.viewport.borrow_mut() = new;
+        self.floating_panes.constrain_desktop_viewport(new);
+        self.tiled_panes.resize_pty_all_panes()?;
+        self.floating_panes.resize_pty_all_panes(&mut self.os_api)?;
+        self.tiled_panes.reset_boundaries();
+        self.set_should_clear_display_before_rendering();
+        self.set_force_render();
+        self.senders.send_to_pty_writer(PtyWriteInstruction::ApplyCachedResizes)?;
+        Ok(())
+    }
